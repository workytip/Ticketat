              "mode": "raw",
              "raw": "{\n  \"name\": \"Sara Ali\",\n  \"email\": \"sara@example.com\",\n  \"password\": \"Secret-Pass-2026\",\n  \"passwordConfirmation\": \"Secret-Pass-2026\",\n  \"deviceName\": \"postman\"\n}",
