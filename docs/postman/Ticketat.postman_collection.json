                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept-Language",
                    "value": "{{locale}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/register",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "register"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Sara Ali\",\n  \"email\": \"sara@example.com\",\n  \"password\": \"Secret-Pass-2026\",\n  \"passwordConfirmation\": \"Secret-Pass-2026\",\n  \"deviceName\": \"postman\"\n}"
                }
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"data\": {\n    \"user\": {\n      \"id\": 1,\n      \"name\": \"Sara Ali\",\n      \"email\": \"sara@example.com\",\n      \"emailVerifiedAt\": null,\n      \"createdAt\": \"2026-11-27T13:09:21+00:00\"\n    },\n    \"token\": \"1|3lEglZqnyBINolAx7CoIYw633HYXbfIa9CLwY4yGc064c14e\",\n    \"tokenType\": \"Bearer\"\n  }\n}"
            },
            {
              "name": "422 Validation error",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept-Language",
                    "value": "{{locale}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/register",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "register"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"bad\",\n  \"passwordConfirmation\": \"x\"\n}"
                }
              },
              "status": "Unprocessable Content",
              "code": 422,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"message\": \"The name field is required. (and 4 more errors)\",\n  \"errors\": {\n    \"name\": [\n      \"The name field is required.\"\n    ],\n    \"email\": [\n      \"The email field must be a valid email address.\"\n    ],\n    \"password\": [\n      \"The password field is required.\"\n    ],\n    \"passwordConfirmation\": [\n      \"The password confirmation field must match password.\"\n    ],\n    \"deviceName\": [\n      \"The device name field is required.\"\n    ]\n  }\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const token = pm.response.json().data.token;",
                  "    pm.environment.set('token', token);",
                  "    console.log('Token saved to environment');",
                  "}"
                ]
              }
            }
          ]
