{
  "info": {
    "name": "Ticketat API",
    "description": "Ticketat REST API v1.\n\nSelect the **Ticketat Local** environment, then run Auth → Register or Login: the token is saved and used by every protected request.\n\nConventions: docs/api/conventions.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
